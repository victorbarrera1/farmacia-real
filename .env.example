# ================================================================
# Variables de entorno de Farmacias Real
# ----------------------------------------------------------------
# Copiar a `.env` para desarrollo local (está en .gitignore) y cargar
# las mismas en Vercel → Project → Settings → Environment Variables.
#
# Sin estas variables el sitio funciona igual, pero en "modo local":
# los datos del panel viven solo en el navegador de quien edita.
# ================================================================

# --- Almacén (Vercel Storage → KV / Upstash Redis) ---------------
# Vercel las inyecta solas al crear la base; para desarrollo local se
# pueden pegar acá o usar ALMACEN=archivo.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Fuerza el driver de archivos (.data/) en local, ignorando KV.
# ALMACEN=archivo

# --- Acceso al panel (/panel) ------------------------------------
# Generar con:  npm run clave -- "TuClaveSegura"
# ADMIN_PASS_HASH es el hash scrypt del ADMIN GLOBAL (formato scrypt:N:r:p:sal:hash).
# La clave no se guarda en ninguna parte y nunca llega al navegador.
ADMIN_PASS_HASH=
ADMIN_SESSION_SECRET=

# Claves por sucursal (encargados de local). JSON en una sola línea:
#   {"independencia":"scrypt:16384:8:1:sal:hash","nunoa":"scrypt:..."}
# Cada encargado solo puede tocar el stock, los precios y la visibilidad de su
# local, y ver los pedidos de su sucursal. Lo genera el mismo npm run clave.
SUCURSAL_PASS_HASHES=

# --- Fallback sin backend (solo desarrollo) ----------------------
# Hash PBKDF2 que se compara en el navegador cuando no hay API.
# No es control de acceso real: no usar en producción.
# NEXT_PUBLIC_ADMIN_PASS_HASH=
# NEXT_PUBLIC_ADMIN_PASS_SALT=
