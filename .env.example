# ================================================================
# Variables de entorno de Farmacias Real
# ----------------------------------------------------------------
# Copiar a `.env` para desarrollo local (está en .gitignore) y cargar
# las mismas en Vercel → Project → Settings → Environment Variables.
#
# Sin estas variables el sitio funciona igual, pero en "modo local":
# los datos del panel viven solo en el navegador de quien edita.
# ================================================================

# --- Almacén (Vercel Storage → KV / Upstash Redis) ---------------
# Vercel las inyecta solas al crear la base; para desarrollo local se
# pueden pegar acá o usar ALMACEN=archivo.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Fuerza el driver de archivos (.data/) en local, ignorando KV.
# ALMACEN=archivo

# --- Acceso al panel (/panel) ------------------------------------
# Generar ambos con:  npm run clave -- "TuClaveSegura"
# ADMIN_PASS_HASH es el hash scrypt: la clave NO se guarda en ninguna parte.
ADMIN_PASS_HASH=
ADMIN_SESSION_SECRET=

# --- Fallback sin backend (opcional) -----------------------------
# Hash PBKDF2 que se compara en el navegador cuando no hay API.
# No es control de acceso real; solo evita exponer la clave en el bundle.
# VITE_ADMIN_PASS_HASH=
# VITE_ADMIN_PASS_SALT=
